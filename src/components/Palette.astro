---
import type { PaletteKind } from '../lib/color';
import { paletteVar, pickInk } from '../lib/color';
import { getLang, useT } from '../i18n/ui';
import CopyButton from './CopyButton.astro';

interface Props {
  kind: PaletteKind;
  colors: string[];
  /** 用於 CSS 變數命名，例如 mocha-mousse */
  slug: string;
}

const EN_NAMES: Record<PaletteKind, string> = {
  complementary: 'Complementary',
  analogous: 'Analogous',
  triadic: 'Triadic',
  split: 'Split complementary',
  mono: 'Monochrome',
};

const { kind, colors, slug } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const name = t(`palette.${kind}`);
const note = t(`palette.${kind}.note`);
const cssVars = colors.map((hex, i) => `${paletteVar(slug, kind, i)}: ${hex};`).join('\n');
---

<figure class="space-y-3">
  <figcaption class="flex items-baseline justify-between gap-4">
    <span>
      <span class:list={[lang === 'zh-tw' ? 'font-serif-tc text-lg' : 'font-display text-lg']}>
        {name}
      </span>
      {lang === 'zh-tw' && <span class="eyebrow ml-2 text-smoke">{EN_NAMES[kind]}</span>}
    </span>
    <CopyButton value={cssVars} label={t('palette.cssVars', { name })} />
  </figcaption>
  <ul class="flex h-28 overflow-hidden md:h-36">
    {colors.map((hex) => (
      <li
        class="paper-fiber group relative flex flex-1 items-end p-2 transition-[flex-grow] duration-500 ease-out-expo hover:flex-[1.6]"
        style={`background:${hex}; color:${pickInk(hex).ink}`}
        data-cursor-color={hex}
      >
        <code
          class:list={[
            'font-mono text-[0.625rem]',
            pickInk(hex).needsPlate && 'rounded-sm bg-paper/85 px-1 text-ink',
          ]}
        >
          {hex}
        </code>
      </li>
    ))}
  </ul>
  <p class="text-xs text-smoke">{note}</p>
</figure>
