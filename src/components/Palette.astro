---
import type { PaletteKind } from '../lib/color';
import { pickInk } from '../lib/color';
import CopyButton from './CopyButton.astro';

interface Props {
  kind: PaletteKind;
  colors: string[];
  /** 用於 CSS 變數命名，例如 mocha-mousse */
  slug: string;
}

const LABELS: Record<PaletteKind, { zh: string; en: string; note: string }> = {
  complementary: { zh: '互補', en: 'Complementary', note: '色相相差 180°，對比最強' },
  analogous: { zh: '類似', en: 'Analogous', note: '色相左右各 30°，和諧柔順' },
  triadic: { zh: '三角', en: 'Triadic', note: '色相每 120° 一色，活潑平衡' },
  split: { zh: '分裂互補', en: 'Split complementary', note: '互補色左右各 30°，對比較溫和' },
  mono: { zh: '單色', en: 'Monochrome', note: '同色相，明度由深到淺' },
};

const { kind, colors, slug } = Astro.props;
const label = LABELS[kind];
const cssVars = colors.map((hex, i) => `--${slug}-${kind}-${i + 1}: ${hex};`).join('\n');
---

<figure class="space-y-3">
  <figcaption class="flex items-baseline justify-between gap-4">
    <span>
      <span class="font-serif-tc text-lg">{label.zh}</span>
      <span class="eyebrow ml-2 text-smoke">{label.en}</span>
    </span>
    <CopyButton value={cssVars} label={`${label.zh}配色 CSS 變數`} />
  </figcaption>
  <ul class="flex h-28 overflow-hidden md:h-36">
    {colors.map((hex) => (
      <li
        class="group relative flex flex-1 items-end p-2 transition-[flex-grow] duration-500 ease-out-expo hover:flex-[1.6]"
        style={`background:${hex}; color:${pickInk(hex).ink}`}
      >
        <code class="font-mono text-[0.625rem] opacity-80">{hex}</code>
      </li>
    ))}
  </ul>
  <p class="text-xs text-smoke">{label.note}</p>
</figure>
