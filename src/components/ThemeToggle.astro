---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- 在 JS 載入前停用，避免還不能切換時被點擊 -->
<button
  type="button"
  data-theme-toggle
  disabled
  aria-pressed="false"
  aria-label="切換深淺色"
  class:list={[
    'group inline-flex size-9 items-center justify-center rounded-full border border-current/25 transition-colors hover:bg-current/10 disabled:opacity-40',
    className,
  ]}
>
  <!-- 淺色模式顯示月亮（切到深色），深色模式顯示太陽 -->
  <svg
    viewBox="0 0 24 24"
    class="size-[18px] group-aria-pressed:hidden"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    aria-hidden="true"
  >
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" stroke-linejoin="round"></path>
  </svg>
  <svg
    viewBox="0 0 24 24"
    class="hidden size-[18px] group-aria-pressed:block"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
  </svg>
</button>
