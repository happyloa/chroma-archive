---
import type { DerivedColor } from '../lib/color';
import CopyButton from './CopyButton.astro';
import { getLang, useT } from '../i18n/ui';

interface Props {
  color: DerivedColor & { name: string };
}

const { color: c } = Astro.props;
const t = useT(getLang(Astro.currentLocale));
const rows = [
  { label: 'HEX', value: c.hex },
  { label: 'RGB', value: `rgb(${c.rgb.join(' ')})` },
  { label: 'HSL', value: `hsl(${c.hsl[0]} ${c.hsl[1]}% ${c.hsl[2]}%)` },
  { label: 'OKLCH', value: `oklch(${c.oklch.l} ${c.oklch.c} ${c.oklch.h})` },
  { label: 'LAB', value: `lab(${c.lab.l} ${c.lab.a} ${c.lab.b})` },
];
---

<dl class="divide-y divide-ink/10 border-y border-ink/10">
  {rows.map((r) => (
    <div class="flex items-center gap-4 py-3">
      <dt class="eyebrow w-16 shrink-0 text-smoke">{r.label}</dt>
      <dd class="flex flex-1 items-center justify-between gap-3">
        <code class="font-mono text-sm">{r.value}</code>
        <CopyButton value={r.value} label={`${c.name} ${r.label} ${r.value}`} />
      </dd>
    </div>
  ))}
</dl>
<p class="mt-3 text-xs text-smoke">{t('year.valuesNote')}</p>
