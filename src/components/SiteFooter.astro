---
import { getYears } from '../lib/data';
import { REPO_URL } from '../lib/site';
import { getLang, localePath, useT } from '../i18n/ui';

const years = await getYears();
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
---

<footer class="relative z-10 mt-section border-t border-ink/10">
  <div class="page-grid gap-y-10 py-12">
    <div class="col-span-4 md:col-span-5">
      <p class="font-display text-title">Chroma Archive</p>
      <p class="mt-3 max-w-[32ch] text-sm text-smoke">
        {t('site.tagline', { from: years[0]!.year, to: years.at(-1)!.year })}
      </p>
    </div>
    <nav aria-label={t('nav.footer')} class="col-span-2 md:col-span-3">
      <ul class="space-y-1 text-sm">
        <li>
          <a href={localePath(lang, '/archive/')} class="hover:underline">
            {t('nav.archive')}
          </a>
        </li>
        <li>
          <a href={localePath(lang, '/space/')} class="hover:underline">
            {t('nav.space')}
          </a>
        </li>
        <li>
          <a href={localePath(lang, '/about/')} class="hover:underline">
            {t('nav.aboutSite')}
          </a>
        </li>
        <li>
          <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="hover:underline">
            {t('nav.githubShort')}
            <span aria-hidden="true"> ↗</span>
            <span class="sr-only">{t('nav.newTab')}</span>
          </a>
        </li>
      </ul>
    </nav>
    <p class="col-span-4 text-xs leading-relaxed text-smoke md:col-span-4">
      {t('site.disclaimer')}
    </p>
  </div>
</footer>
