---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="page-grid gap-y-6 pt-32 pb-16 md:pt-40">
  <p class="eyebrow col-span-4 text-smoke md:col-span-12">{eyebrow}</p>
  <h1 class="col-span-4 font-display text-display font-light md:col-span-10" data-split>
    {title}
  </h1>
  {/* 首屏的說明一開始就顯示，不做淡入：它常是 LCP 元素，等 JS 才出現會拖慢 LCP */}
  {lead && <p class="col-span-4 max-w-[38em] text-lead text-smoke md:col-span-7">{lead}</p>}
  <slot />
</section>
