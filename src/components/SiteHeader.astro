---
import { REPO_URL } from '../lib/site';
import { getLang, localePath, stripLocale, useT } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** 頁首下方第一個區塊的背景：決定文字用哪個顏色 */
  tone?: 'paper' | 'coty' | 'ink';
}

const { tone = 'paper' } = Astro.props;
const toneClass = { paper: 'text-ink', coty: 'text-coty-ink', ink: 'text-day' }[tone];

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const base = stripLocale(Astro.url.pathname);
const links = [
  { path: '/archive/', label: t('nav.archive') },
  { path: '/space/', label: t('nav.space') },
  { path: '/about/', label: t('nav.about') },
];
// 切換語言：同一頁的另一個語系版本
const otherLang = lang === 'en' ? 'zh-tw' : 'en';
const otherHtmlLang = otherLang === 'en' ? 'en' : 'zh-Hant-TW';
---

{/* 疊在第一個區塊上方，隨頁面捲走；文字色依該區塊背景決定 */}
<header
  class:list={[
    'absolute inset-x-0 top-0 z-30 flex items-center justify-between gap-6 px-gutter py-4',
    toneClass,
  ]}
>
  <a
    href={localePath(lang, '/')}
    class="eyebrow tracking-[0.22em]"
    aria-current={base === '/' ? 'page' : undefined}
  >
    Chroma Archive
  </a>
  <nav aria-label={t('nav.main')}>
    <ul class="flex items-center gap-4 text-sm sm:gap-8">
      {links.map((l) => (
        <li>
          <a
            href={localePath(lang, l.path)}
            class="underline-offset-4 hover:underline aria-[current=page]:underline"
            aria-current={base.startsWith(l.path) ? 'page' : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
      <li class="max-sm:hidden">
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 underline-offset-4 hover:underline"
          aria-label={t('nav.github')}
        >
          GitHub<span aria-hidden="true">↗</span>
        </a>
      </li>
      <li>
        <a
          href={localePath(otherLang, base)}
          hreflang={otherHtmlLang}
          lang={otherHtmlLang}
          class="underline-offset-4 hover:underline"
          aria-label={t('lang.switchLabel')}
          data-lang-switch
        >
          {t('lang.switch')}
        </a>
      </li>
      <li>
        <ThemeToggle />
      </li>
    </ul>
  </nav>
</header>
