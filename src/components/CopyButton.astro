---
interface Props {
  /** 要複製的文字 */
  value: string;
  /** 給螢幕閱讀器的說明，例如「HEX #A47864」 */
  label: string;
  class?: string;
}

const { value, label, class: className } = Astro.props;
---

<button
  type="button"
  data-copy={value}
  data-copy-label={label}
  class:list={[
    'eyebrow cursor-pointer rounded-full border border-current/25 px-2.5 py-1 text-[0.625rem] opacity-70 transition hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100',
    className,
  ]}
  aria-label={`複製 ${label}`}
>
  <span data-copy-text>複製</span>
</button>
