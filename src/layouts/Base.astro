---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/fraunces/opsz.css';
// 標題字型的拉丁字檔預載：預載畫面與首頁的大年份用 Fraunces，
// 字型晚到的話，年份會先用備用字型畫出來，換上 Fraunces 時字變大，被算成新的 LCP
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import '@fontsource-variable/inter';
import '@fontsource-variable/noto-serif-tc';
import '@fontsource-variable/noto-sans-tc';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { pickInk, scrollbarColors } from '../lib/color';
import { getLatestYear } from '../lib/data';
import { HTML_LANG, OG_LOCALE, getLang, localePath, stripLocale, useT } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  /** 這一頁要用的 WebGL 場景 */
  scene?: string;
  /** 這一頁的年度色，寫入 --coty */
  color?: string;
  /** 第一個區塊的背景，決定頁首文字色 */
  headerTone?: 'paper' | 'coty' | 'ink';
  /** OG 分享圖路徑，預設是站名圖 */
  ogImage?: string;
  /** 不讓搜尋引擎收錄（彩蛋頁） */
  noindex?: boolean;
}

const {
  title,
  description: descriptionProp,
  scene = 'none',
  color: colorProp,
  headerTone = 'paper',
  ogImage = '/og/default.png',
  noindex = false,
} = Astro.props;

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const description = descriptionProp ?? t('site.description');
const basePath = stripLocale(Astro.url.pathname);
// 404 只有一頁（中英並列）：不輸出 canonical 與 hreflang，也不讓搜尋引擎收錄
const isNotFound = basePath.startsWith('/404');
const alternates = isNotFound
  ? []
  : [
      { hreflang: 'zh-Hant-TW', href: new URL(localePath('zh-tw', basePath), Astro.site) },
      { hreflang: 'en', href: new URL(localePath('en', basePath), Astro.site) },
      { hreflang: 'x-default', href: new URL(basePath, Astro.site) },
    ];

// 沒指定顏色的頁面（關於、色彩空間等）用最新年度色
const color = colorProp ?? (await getLatestYear()).colors[0]!.hex;
const { ink } = pickInk(color);
// 捲軸：滑塊是這一頁的年度色，軌道是互補色相並調整明度，對比至少 3:1（首頁等總覽頁用最新年度色）
const { track: scrollTrack } = scrollbarColors(color);
const separator = lang === 'en' ? ' | ' : '｜';
const fullTitle = title === 'Chroma Archive' ? title : `${title}${separator}Chroma Archive`;
---

<html
  lang={HTML_LANG[lang]}
  style={`--coty: ${color}; --coty-ink: ${ink}; --scroll-thumb: ${color}; --scroll-track: ${scrollTrack}`}
>
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {(noindex || isNotFound) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={color} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!isNotFound && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {/* 首次繪製前決定動態偏好與 WebGL 可用性；換頁後 <html> 屬性會被換掉，所以在 after-swap 再套一次 */}
    <script is:inline>
      (() => {
        const apply = () => {
          const root = document.documentElement;
          // 依動態偏好與 WebGL 可用性顯示或隱藏 3D 區塊，首次繪製前決定才不會造成版面跳動
          root.dataset.motion = matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'reduce'
            : 'full';
          if (window.__chromaWebgl === undefined) {
            window.__chromaLite = false;
            try {
              const gl = document.createElement('canvas').getContext('webgl2');
              window.__chromaWebgl = !!gl;
              // 軟體算繪、省流量、記憶體很少：判定規則和 src/stage/quality.ts 的低畫質檔位一致
              const debug = gl && gl.getExtension('WEBGL_debug_renderer_info');
              const gpu = debug ? String(gl.getParameter(debug.UNMASKED_RENDERER_WEBGL)) : '';
              const nav = navigator;
              // e2e 測試設定 __chromaForceFull，在軟體算繪的瀏覽器裡照樣測 3D（tests/e2e/fixtures.ts）
              window.__chromaLite =
                !window.__chromaForceFull &&
                (/swiftshader|llvmpipe|software|basic render/i.test(gpu) ||
                  !!(nav.connection && nav.connection.saveData) ||
                  (nav.deviceMemory !== undefined && nav.deviceMemory <= 2));
            } catch {
              window.__chromaWebgl = false;
            }
          }
          root.dataset.webgl = window.__chromaWebgl ? 'on' : 'off';
          // 裝飾性 3D（主視覺、設計發想、時間軸、色彩空間）改用靜態內容；只在進站時判定，之後不變
          root.dataset.lite = window.__chromaLite ? 'on' : 'off';
          // 文字出場動畫設好前先隱藏；萬一腳本沒載入，2.5 秒後一定顯示
          if (root.dataset.motion === 'full') {
            root.classList.add('motion-pending');
            setTimeout(() => root.classList.remove('motion-pending'), 2500);
          }
        };
        apply();
        if (!window.__chromaHeadInit) {
          window.__chromaHeadInit = true;
          document.addEventListener('astro:after-swap', apply);
          // 站內換頁過就不再播首頁預載畫面（Preloader.astro）
          document.addEventListener('astro:before-preparation', () => {
            window.__chromaNavigated = true;
          });
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    {/* 換頁轉場的墨水層：透明，只用來產生 view-transition 群組（global.css） */}
    <div class="vt-ink" aria-hidden="true"></div>
    <a
      href="#content"
      class="sr-only z-50 bg-ink px-4 py-2 text-paper focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      {t('a11y.skip')}
    </a>
    <canvas
      id="stage"
      class="pointer-events-none fixed inset-0 z-0 block h-screen w-screen"
      transition:persist="stage"
      aria-hidden="true"
    ></canvas>
    <SiteHeader tone={headerTone} />
    <main id="content" class="relative z-10" data-scene={scene} data-color={color}>
      <slot />
    </main>
    <SiteFooter />
    <p id="announcer" class="sr-only" aria-live="polite"></p>
    <script>
      import '../app/boot';
    </script>
  </body>
</html>
