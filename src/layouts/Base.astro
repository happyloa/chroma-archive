---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/noto-serif-tc';
import '@fontsource-variable/noto-sans-tc';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { pickInk } from '../lib/color';

interface Props {
  title: string;
  description?: string;
  /** 這一頁要用的 WebGL 場景（見 plan.md 2.1） */
  scene?: string;
  /** 這一頁的年度色，寫入 --coty */
  color?: string;
  /** 第一個區塊的背景，決定頁首文字色 */
  headerTone?: 'paper' | 'coty' | 'ink';
}

const {
  title,
  description = 'Pantone 歷年年度代表色與產品設計發想。',
  scene = 'none',
  color = '#F0EEE9',
  headerTone = 'paper',
} = Astro.props;

const { ink } = pickInk(color);
const fullTitle = title === 'Chroma Archive' ? title : `${title}｜Chroma Archive`;
---

<html lang="zh-Hant-TW" style={`--coty: ${color}; --coty-ink: ${ink}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={color} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <!-- 首次繪製前套用深淺色，避免閃爍；換頁後 <html> 屬性會被換掉，所以在 after-swap 再套一次 -->
    <script is:inline>
      (() => {
        const apply = () => {
          let theme = null;
          try {
            theme = localStorage.getItem('chroma-theme');
          } catch {
            // 儲存空間被封鎖時改用系統設定
          }
          if (theme !== 'light' && theme !== 'dark') {
            theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = theme;
        };
        apply();
        if (!window.__chromaThemeInit) {
          window.__chromaThemeInit = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <a
      href="#content"
      class="sr-only z-50 bg-ink px-4 py-2 text-paper focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      跳到主要內容
    </a>
    <canvas
      id="stage"
      class="pointer-events-none fixed inset-0 z-0 block h-screen w-screen"
      transition:persist="stage"
      aria-hidden="true"
    ></canvas>
    <SiteHeader tone={headerTone} />
    <main id="content" class="relative z-10" data-scene={scene} data-color={color}>
      <slot />
    </main>
    <SiteFooter />
    <p id="announcer" class="sr-only" aria-live="polite"></p>
    <script>
      import '../app/boot';
    </script>
  </body>
</html>
