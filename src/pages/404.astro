---
import Base from '../layouts/Base.astro';
import { getYears } from '../lib/data';
import { useT } from '../i18n/ui';

// 404 只有一個，所以中英並列
const zh = useT('zh-tw');
const en = useT('en');
const years = await getYears();
const latest = years.at(-1)!;
// 每次開啟隨機換成某一年的顏色（inline script），沒有 JS 時顯示最新年度色
const choices = years.map((y) => ({
  year: y.year,
  name: y.colors.map((c) => c.name).join(' & '),
  hex: y.colors[0]!.hex,
  hexes: y.colors.map((c) => c.hex),
}));
---

<Base title={zh('notFound.metaTitle')} color={latest.colors[0]!.hex}>
  <section class="page-grid min-h-[80svh] content-end gap-y-6 pt-32">
    <p class="eyebrow col-span-4 text-smoke md:col-span-12">404</p>
    <h1 class="col-span-4 font-display text-display font-light md:col-span-10">
      {zh('notFound.title')}
      <span lang="en" class="mt-4 block text-headline text-smoke">
        {en('notFound.title')}
      </span>
    </h1>
    <p class="col-span-4 text-lead text-smoke md:col-span-6">
      {zh('notFound.lead')}
      <span lang="en" class="mt-2 block">
        {en('notFound.lead')}
      </span>
    </p>
    <figure class="col-span-2 md:col-span-3" data-random-color={JSON.stringify(choices)}>
      <a href={`/years/${latest.year}/`} class="group block bg-chip p-[5%] pb-[4%] text-night">
        <span
          class="paper-fiber flex aspect-[5/4]"
          data-random-swatch
          aria-hidden="true"
          style={`background:${latest.colors[0]!.hex}`}
        ></span>
        <span class="mt-3 flex items-baseline justify-between gap-3">
          <span class="font-display text-title tabular-nums" data-random-year>
            {latest.year}
          </span>
          <span class="text-sm" data-random-name>
            {latest.colors.map((c) => c.name).join(' & ')}
          </span>
        </span>
      </a>
      <figcaption class="mt-2 text-xs text-smoke">
        {zh('notFound.random')}
        <span lang="en"> · {en('notFound.random')}</span>
      </figcaption>
    </figure>
    <div class="col-span-4 flex flex-wrap gap-6 md:col-span-12">
      <a href="/" class="eyebrow border-b border-current pb-1">
        {zh('notFound.home')}
      </a>
      <a href="/archive/" class="eyebrow border-b border-current pb-1">
        {zh('notFound.archive')}
      </a>
      <a href="/en/" lang="en" class="eyebrow border-b border-current pb-1">
        {en('notFound.home')}
      </a>
      <a href="/en/archive/" lang="en" class="eyebrow border-b border-current pb-1">
        {en('notFound.archive')}
      </a>
    </div>
  </section>
  <script is:inline data-astro-rerun>
    (() => {
      const fig = document.querySelector('[data-random-color]');
      if (!fig) return;
      const list = JSON.parse(fig.dataset.randomColor || '[]');
      const pick = list[Math.floor(Math.random() * list.length)];
      if (!pick) return;
      const stops = pick.hexes
        .map(
          (c, i) =>
            c +
            ' ' +
            (i / pick.hexes.length) * 100 +
            '% ' +
            ((i + 1) / pick.hexes.length) * 100 +
            '%',
        )
        .join(', ');
      fig.querySelector('[data-random-swatch]').style.background =
        'linear-gradient(90deg, ' + stops + ')';
      fig.querySelector('[data-random-year]').textContent = pick.year;
      fig.querySelector('[data-random-name]').textContent = pick.name;
      fig.querySelector('a').href = '/years/' + pick.year + '/';
      document.documentElement.style.setProperty('--scroll-thumb', pick.hex);
    })();
  </script>
</Base>
