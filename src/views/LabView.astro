---
import Base from '../layouts/Base.astro';
import type { YearEntry } from '../lib/data';
import { FINISHES, LIGHTS, PRODUCTS } from '../lib/schema';
import { ACCEPTED_EXTENSIONS, MAX_UPLOAD_BYTES } from '../stage/upload';
import { getLang, localePath, useT, type UiKey } from '../i18n/ui';

interface Props {
  entry: YearEntry;
  years: YearEntry[];
}

const { entry, years } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const { year, colors } = entry;
const main = colors[0]!;
const names = colors.map((c) => c.name).join(' & ');

const ROOMS = ['studio', 'living', 'bedroom', 'office'] as const;
const CAMERAS = ['hero', 'front', 'side', 'top', 'detail'] as const;
const label = (prefix: string, value: string) => t(`${prefix}.${value}` as UiKey);

// 輔色預設：雙色年份用第二色，否則用互補色
const accentDefault = colors[1]?.hex ?? main.palettes.complementary[1]!;
const accentChoices = [
  ...new Set([accentDefault, ...main.palettes.analogous, ...main.palettes.triadic.slice(1)]),
].filter((h) => h !== main.hex);
---

<Base
  title={t('lab.metaTitle', { year, names })}
  description={t('lab.description', { year, names })}
  scene="lab"
  color={main.hex}
>
  <section class="page-grid gap-y-6 pt-32 pb-10 md:pt-36">
    <p class="eyebrow col-span-4 text-smoke md:col-span-12">
      <a href={localePath(lang, `/years/${year}/`)} class="hover:underline">
        {year} {names}
      </a>{' '}
      / Product Lab
    </p>
    <h1 class="col-span-4 font-display text-headline font-light md:col-span-12">
      {t('lab.title')}
    </h1>
  </section>

  <form
    id="lab-form"
    class="page-grid gap-y-10"
    aria-label={t('lab.form')}
    data-year={year}
    data-primary={main.hex}
  >
    <div class="col-span-4 space-y-4 md:col-span-8">
      <fieldset class="flex flex-wrap items-center gap-2">
        <legend class="sr-only">{t('lab.scenes')}</legend>
        {ROOMS.map((r, i) => (
          <label class="cursor-pointer rounded-full border border-ink/15 px-3.5 py-1.5 text-sm transition-colors hover:border-ink/40 has-checked:border-ink has-checked:bg-ink has-checked:text-paper has-focus-visible:outline-2 has-focus-visible:outline-offset-2">
            <input type="radio" name="s" value={r} checked={i === 0} class="sr-only" />
            {label('room', r)}
          </label>
        ))}
      </fieldset>

      {/* 預覽區：WebGL 場景會畫在這個區塊的位置 */}
      <div
        id="lab-viewport"
        class="relative col-span-4 flex aspect-square cursor-grab items-center justify-center overflow-hidden bg-mist active:cursor-grabbing md:col-span-8 md:aspect-[4/3]"
        data-view="product"
        data-interactive
        data-product="chair"
        data-finish="matte"
        data-primary={main.hex}
        data-accent={accentDefault}
        data-light="studio"
        data-room="studio"
        role="img"
        aria-label={t('lab.viewport', { names })}
      >
        {/* 不支援 WebGL 時顯示的替代圖；3D 視窗就緒後隱藏 */}
        <div
          data-fallback
          class="aspect-square w-1/3 rounded-[38%_42%_30%_34%] shadow-[0_40px_60px_-30px_rgb(0_0_0/0.45)]"
          style={`background: radial-gradient(circle at 30% 25%, rgb(255 255 255 / 0.35), transparent 55%), ${main.hex}`}
          aria-hidden="true"
        ></div>
        <p class="absolute bottom-4 left-4 text-xs text-smoke" data-fallback>
          {t('lab.noWebgl')}
        </p>
        <p
          class="pointer-events-none absolute bottom-4 left-4 hidden text-xs text-smoke"
          data-ready-hint
        >
          {t('lab.hint')}
        </p>
        <p
          id="lab-photo-status"
          class="pointer-events-none absolute top-4 right-4 hidden rounded-full bg-night/70 px-3 py-1 text-xs text-day tabular-nums backdrop-blur"
          aria-live="polite"
        ></p>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3">
        <fieldset class="flex flex-wrap items-center gap-2">
          <legend class="sr-only">{t('lab.cameras')}</legend>
          {CAMERAS.map((c, i) => (
            <label class="cursor-pointer rounded-full border border-ink/15 px-3.5 py-1.5 text-sm transition-colors hover:border-ink/40 has-checked:border-ink has-checked:bg-ink has-checked:text-paper has-focus-visible:outline-2 has-focus-visible:outline-offset-2">
              <input type="radio" name="cam" value={c} checked={i === 0} class="sr-only" />
              {label('camera', c)}
            </label>
          ))}
        </fieldset>
        <label class="inline-flex cursor-pointer items-center gap-2 text-sm">
          <input type="checkbox" name="spin" value="1" checked class="peer sr-only" />
          <span
            class="relative h-5 w-9 rounded-full bg-ink/20 transition-colors peer-checked:bg-ink peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 after:absolute after:top-0.5 after:left-0.5 after:size-4 after:rounded-full after:bg-paper after:transition-transform peer-checked:after:translate-x-4"
            aria-hidden="true"
          ></span>
          {t('lab.spin')}
        </label>
        <label
          class="inline-flex cursor-pointer items-center gap-2 text-sm"
          title={t('lab.photoTitle')}
        >
          <input type="checkbox" name="q" value="photo" class="peer sr-only" />
          <span
            class="relative h-5 w-9 rounded-full bg-ink/20 transition-colors peer-checked:bg-ink peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 after:absolute after:top-0.5 after:left-0.5 after:size-4 after:rounded-full after:bg-paper after:transition-transform peer-checked:after:translate-x-4"
            aria-hidden="true"
          ></span>
          {t('lab.photo')}
        </label>
      </div>
      <p class="text-xs text-smoke" id="lab-photo-note">
        {t('lab.photoNote')}
      </p>
    </div>

    <div class="col-span-4 space-y-8 md:col-span-4">
      <fieldset>
        <legend class="eyebrow mb-3 text-smoke">{t('lab.product')}</legend>
        <div class="grid grid-cols-2 gap-2">
          {PRODUCTS.map((p, i) => (
            <label class="cursor-pointer border border-ink/15 px-3 py-2 text-sm has-checked:border-ink has-checked:bg-ink has-checked:text-paper">
              <input type="radio" name="p" value={p} checked={i === 0} class="sr-only" />
              {label('product', p)}
            </label>
          ))}
          {/* 上傳模型後才出現 */}
          <label
            id="lab-custom-option"
            hidden
            class="col-span-2 cursor-pointer truncate border border-ink/15 px-3 py-2 text-sm has-checked:border-ink has-checked:bg-ink has-checked:text-paper"
          >
            <input type="radio" name="p" value="custom" class="sr-only" />
            <span data-custom-name>{t('lab.myModel')}</span>
          </label>
        </div>

        <div class="mt-3">
          <label class="flex cursor-pointer items-center justify-center gap-2 border border-dashed border-ink/30 px-3 py-3 text-sm transition-colors hover:border-ink has-focus-visible:outline-2 has-focus-visible:outline-offset-2">
            <input
              id="lab-upload"
              type="file"
              accept={ACCEPTED_EXTENSIONS.join(',')}
              class="sr-only"
              aria-describedby="lab-upload-note"
            />
            <span aria-hidden="true">＋</span> {t('lab.upload')}
          </label>
          <p id="lab-upload-note" class="mt-2 text-xs leading-relaxed text-smoke">
            {t('lab.uploadNote', {
              formats: ACCEPTED_EXTENSIONS.join(lang === 'en' ? ', ' : '、'),
              size: MAX_UPLOAD_BYTES / 1024 / 1024,
            })}
          </p>
          <p id="lab-upload-status" class="mt-1 text-xs" role="status" aria-live="polite"></p>
        </div>
      </fieldset>

      <fieldset>
        <legend class="eyebrow mb-3 text-smoke">{t('lab.finish')}</legend>
        <div class="grid grid-cols-3 gap-2">
          {FINISHES.map((f, i) => (
            <label class="cursor-pointer border border-ink/15 px-3 py-2 text-center text-sm has-checked:border-ink has-checked:bg-ink has-checked:text-paper">
              <input type="radio" name="f" value={f} checked={i === 0} class="sr-only" />
              {label('finish', f)}
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset
        data-slot="primary"
        class="-m-2 rounded p-2 transition-shadow data-[picked]:ring-2 data-[picked]:ring-ink"
      >
        <legend class="eyebrow mb-3 text-smoke">{t('lab.primary')}</legend>
        <div class="flex flex-wrap gap-2">
          {years.flatMap((y) =>
            y.colors.map((c, ci) => (
              <label
                class="size-7 cursor-pointer rounded-full shadow-[inset_0_0_0_1px_rgb(0_0_0/0.12)] has-checked:ring-2 has-checked:ring-ink has-checked:ring-offset-2 has-checked:ring-offset-paper"
                style={`background:${c.hex}`}
                title={`${y.year} ${c.name}`}
              >
                <input
                  type="radio"
                  name="c1"
                  value={`${y.year}-${ci}`}
                  data-hex={c.hex}
                  data-label={`${y.year} ${c.name}`}
                  checked={y.year === year && ci === 0}
                  class="sr-only"
                />
                <span class="sr-only">
                  {y.year} {c.name}
                </span>
              </label>
            )),
          )}
        </div>
      </fieldset>

      <fieldset
        data-slot="accent"
        class="-m-2 rounded p-2 transition-shadow data-[picked]:ring-2 data-[picked]:ring-ink"
      >
        <legend class="eyebrow mb-3 text-smoke">{t('lab.accent')}</legend>
        <p data-accent-note hidden class="mb-3 text-xs text-smoke">
          {t('lab.accentNone')}
        </p>
        <div class="flex flex-wrap gap-2">
          {accentChoices.map((hex, i) => (
            <label
              class="size-7 cursor-pointer rounded-full shadow-[inset_0_0_0_1px_rgb(0_0_0/0.12)] has-checked:ring-2 has-checked:ring-ink has-checked:ring-offset-2 has-checked:ring-offset-paper"
              style={`background:${hex}`}
              title={hex}
            >
              <input type="radio" name="c2" value={hex} checked={i === 0} class="sr-only" />
              <span class="sr-only">{hex}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class="eyebrow mb-3 text-smoke">{t('lab.light')}</legend>
        <div class="grid grid-cols-3 gap-2">
          {LIGHTS.map((l, i) => (
            <label class="cursor-pointer border border-ink/15 px-3 py-2 text-center text-sm has-checked:border-ink has-checked:bg-ink has-checked:text-paper">
              <input type="radio" name="l" value={l} checked={i === 0} class="sr-only" />
              {label('light', l)}
            </label>
          ))}
        </div>
      </fieldset>

      <button
        type="button"
        id="lab-export"
        class="eyebrow w-full bg-ink px-6 py-4 text-paper disabled:cursor-not-allowed disabled:opacity-40"
        disabled
      >
        {t('lab.export')}
      </button>
    </div>
  </form>
</Base>
