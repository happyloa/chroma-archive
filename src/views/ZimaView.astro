---
import Base from '../layouts/Base.astro';
import ColorValues from '../components/ColorValues.astro';
import Palette from '../components/Palette.astro';
import { PALETTE_KINDS, cssVarSlug } from '../lib/color';
import { zima } from '../lib/zima';
import { getLang, useT } from '../i18n/ui';

/**
 * Zima Blue 彩蛋頁（specs/002-zima-blue US-Z3）：版面自成一格，只談這個顏色本身。
 * 不進 sitemap、不在任何導覽裡，從色彩空間的隱藏球進來。
 */
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const key = lang === 'zh-tw' ? 'zh' : 'en';
const zh = key === 'zh';
---

<Base
  title={zima.name}
  description={t('zima.description')}
  color={zima.hex}
  headerTone="coty"
  ogImage="/og/zima.png"
  noindex
>
  {/* 滿版主視覺：液態 shader 套 Zima Blue，沒有 WebGL 時是純色底 */}
  <section
    class="flex min-h-svh flex-col justify-end bg-coty pt-28 pb-gutter text-coty-ink"
    aria-labelledby="zima-title"
    data-view="hero"
    data-motion-only
    data-color={zima.hex}
    data-mode="liquid"
    data-background="#0E0E0E"
  >
    <div class="page-grid items-end gap-y-8">
      <p class="eyebrow col-span-4 md:col-span-12">
        {t('zima.eyebrow')}
        <span aria-hidden="true"> · </span>
        <span class="sr-only">，</span>
        {t('zima.notCoty')}
      </p>
      <h1
        id="zima-title"
        class="col-span-4 font-display text-mega font-light md:col-span-12"
        data-split
        lang="en"
      >
        {zima.name}
      </h1>
      <p
        class:list={[
          'col-span-4 max-w-[34ch] text-lead md:col-span-6',
          zh ? 'font-serif-tc' : 'font-display',
        ]}
      >
        {zima.reveal[key]}
      </p>
    </div>
  </section>

  {/* 色值 */}
  <section class="page-grid mt-section gap-y-10" aria-labelledby="zima-values">
    <h2 id="zima-values" class="eyebrow col-span-4 text-smoke md:col-span-3">
      {t('zima.values')}
    </h2>
    <div class="col-span-4 md:col-span-6">
      <ColorValues color={zima.color} />
    </div>
  </section>

  {/* 這片藍：一塊泳池磁磚般的方形，旁邊是短文 */}
  <section class="page-grid mt-section items-center gap-y-10" aria-labelledby="zima-story">
    <h2 id="zima-story" class="eyebrow col-span-4 text-smoke md:col-span-3">
      {t('zima.story')}
    </h2>
    <div class="col-span-4 md:col-span-4" aria-hidden="true">
      <div class="zima-tile relative aspect-square overflow-hidden bg-coty"></div>
    </div>
    <div
      class:list={[
        'col-span-4 space-y-6 text-lead leading-[1.9] md:col-span-5',
        zh ? 'font-serif-tc' : 'font-display',
      ]}
    >
      {zima.story[key].map((p) => (
        <p>{p}</p>
      ))}
    </div>
  </section>

  {/* 配色 */}
  <section class="page-grid mt-section gap-y-10" aria-labelledby="zima-palettes">
    <h2 id="zima-palettes" class="eyebrow col-span-4 text-smoke md:col-span-3">
      {t('zima.palettes')}
    </h2>
    <div class="col-span-4 grid gap-x-col gap-y-12 md:col-span-9 md:grid-cols-2">
      {PALETTE_KINDS.map((kind) => (
        <Palette kind={kind} colors={zima.palettes[kind]} slug={cssVarSlug(zima.name)} />
      ))}
    </div>
  </section>

  {/* 出處 */}
  <section class="page-grid mt-section gap-y-6" aria-labelledby="zima-credit">
    <h2 id="zima-credit" class="eyebrow col-span-4 text-smoke md:col-span-3">
      {t('zima.credit')}
    </h2>
    <div class="col-span-4 max-w-[60ch] space-y-3 text-sm leading-relaxed md:col-span-7">
      <p>{zima.credit[key]}</p>
      <p class="text-smoke">
        HEX：
        <a href={zima.hexSource} class="underline" target="_blank" rel="noopener noreferrer">
          hexcolorpedia<span class="sr-only">{t('nav.newTab')}</span>
        </a>
      </p>
    </div>
  </section>
</Base>
