---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { getYears } from '../lib/data';
import { getLang, useT, type UiKey } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const zh = lang === 'zh-tw';
const years = await getYears();
const from = years[0]!.year;
const to = years.at(-1)!.year;

const CC0 = { name: 'CC0', url: 'https://creativecommons.org/publicdomain/zero/1.0/' };
const CCBY = { name: 'CC BY 4.0', url: 'https://creativecommons.org/licenses/by/4.0/' };
const MODEL_CREDITS = [
  {
    part: 'chair',
    name: 'Modern Arm Chair 01',
    url: 'https://polyhaven.com/a/modern_arm_chair_01',
    author: ['Kuutti Siitonen', 'Poly Haven'],
    license: CC0,
  },
  {
    part: 'vase',
    name: 'Ceramic Vase 03',
    url: 'https://polyhaven.com/a/ceramic_vase_03',
    author: ['James Ray Cock', 'Poly Haven'],
    license: CC0,
  },
  {
    part: 'sneaker',
    name: 'MaterialsVariantsShoe',
    url: 'https://github.com/KhronosGroup/glTF-Sample-Assets/tree/main/Models/MaterialsVariantsShoe',
    author: ['Shopify'],
    license: CCBY,
  },
  {
    part: 'lamp',
    name: 'IridescenceLamp',
    url: 'https://github.com/KhronosGroup/glTF-Sample-Assets/tree/main/Models/IridescenceLamp',
    author: ['Eric Chadwick', 'Wayfair LLC'],
    license: CCBY,
  },
];
const link = (href: string, text: string) =>
  `<a class="underline" href="${href}" rel="noopener noreferrer" target="_blank">${text}</a>`;
// 中文與連結之間不能有換行產生的空白，所以組成一段 HTML（內容全是上面與字典裡的固定字串）
const sep = zh ? '，' : ', ';
const creditHtml = (m: (typeof MODEL_CREDITS)[number]) =>
  `${t(`product.${m.part}` as UiKey)}${zh ? '：' : ': '}${link(m.url, m.name)}${sep}${m.author.join(sep)}${sep}${link(m.license.url, m.license.name)}`;
const scenesHtml = t('about.scenes', { link: link('https://polyhaven.com', 'Poly Haven') });
const heading = zh ? 'font-serif-tc text-title' : 'font-display text-title';
---

<Base title={t('about.metaTitle')} description={t('about.description')}>
  <PageIntro eyebrow="About" title={t('about.title')} />

  <div class="page-grid gap-y-16">
    <section class="col-span-4 space-y-4 md:col-span-7 md:col-start-5" aria-labelledby="about-what">
      <h2 id="about-what" class={heading}>
        {t('about.whatTitle')}
      </h2>
      <p class="text-lead">{t('about.what', { from, to })}</p>
    </section>

    <section
      class="col-span-4 space-y-4 md:col-span-7 md:col-start-5"
      aria-labelledby="about-values"
    >
      <h2 id="about-values" class={heading}>
        {t('about.valuesTitle')}
      </h2>
      <p>{t('about.values1')}</p>
      <p>{t('about.values2')}</p>
    </section>

    <section
      class="col-span-4 space-y-4 md:col-span-7 md:col-start-5"
      aria-labelledby="about-legal"
    >
      <h2 id="about-legal" class={heading}>
        {t('about.legalTitle')}
      </h2>
      <p>{t('about.legal')}</p>
    </section>

    <section
      class="col-span-4 space-y-4 md:col-span-7 md:col-start-5"
      aria-labelledby="about-credits"
    >
      <h2 id="about-credits" class={heading}>
        {t('about.toolsTitle')}
      </h2>
      <p>{t('about.tools')}</p>
    </section>

    <section
      class="col-span-4 space-y-4 md:col-span-7 md:col-start-5"
      aria-labelledby="about-models"
    >
      <h2 id="about-models" class={heading}>
        {t('about.modelsTitle')}
      </h2>
      <p>{t('about.modelsLead')}</p>
      <ul class="space-y-2 text-sm">
        {MODEL_CREDITS.map((m) => (
          <li set:html={creditHtml(m)} />
        ))}
      </ul>
      <p class="text-sm text-smoke">{t('about.modelsProcedural')}</p>
      <p class="text-sm" set:html={scenesHtml} />
    </section>
  </div>
</Base>
