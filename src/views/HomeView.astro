---
import Base from '../layouts/Base.astro';
import Swatch from '../components/Swatch.astro';
import Preloader from '../components/Preloader.astro';
import { getYears } from '../lib/data';
import { getLang, localePath, useT } from '../i18n/ui';
import { localizedContent } from '../i18n/content';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const years = await getYears();
const latest = years.at(-1)!;
const [main] = latest.colors;
const dark = main!.isLight;
const recent = years.slice(-6, -1).reverse();
const colorCount = years.reduce((n, y) => n + y.colors.length, 0);
const from = years[0]!.year;
const { summary } = localizedContent(latest, lang);
---

<Base
  title="Chroma Archive"
  description={t('home.description', { year: latest.year, name: main!.name, from })}
  scene="hero"
  headerTone={dark ? 'ink' : 'coty'}
  color={main!.hex}
>
  <Preloader years={years} />
  {/* Hero：當年度色。淺色年份改用深色底 */}
  <section
    class:list={[
      'flex min-h-svh flex-col justify-end pt-28 pb-gutter',
      dark ? 'bg-night text-day' : 'bg-coty text-coty-ink',
    ]}
    aria-labelledby="hero-title"
    data-view="hero"
    data-motion-only
    data-color={main!.hex}
    data-mode={dark ? 'cloud' : 'liquid'}
    data-background="#0E0E0E"
  >
    <div class="page-grid items-end gap-y-8">
      <p class="eyebrow col-span-4 md:col-span-6">{t('home.eyebrow', { year: latest.year })}</p>
      <p class="eyebrow col-span-4 md:col-span-6 md:text-right">
        Pantone {latest.colors.map((c) => c.code).join(' / ')}
      </p>

      {dark && (
        <div class="col-span-4 md:col-span-5 md:col-start-8 md:row-start-2">
          <div
            class="aspect-[4/5] w-full shadow-[0_0_120px_20px_rgb(255_255_255/0.08)]"
            style={`background:${main!.hex}`}
            aria-hidden="true"
          />
        </div>
      )}

      <h1 id="hero-title" class="col-span-4 md:col-span-12">
        <span
          class="block font-display text-mega font-light tabular-nums"
          data-split
          data-split-exit
        >
          {latest.year}
        </span>
        <span
          class="mt-6 block font-display text-display font-normal italic"
          data-split
          data-split-exit
          lang="en"
        >
          {main!.name}
        </span>
        {lang === 'zh-tw' && (
          <span class="mt-3 block font-serif-tc text-title">{main!.nameZh}</span>
        )}
      </h1>

      <div class="col-span-4 flex flex-wrap items-end justify-between gap-6 md:col-span-12">
        <p class="max-w-[34ch] text-lead">{summary}</p>
        <a
          href={localePath(lang, `/years/${latest.year}/`)}
          class="eyebrow inline-flex items-center gap-3 border-b border-current pb-1"
        >
          {t('home.cta', { year: latest.year })} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  {/* 年度色是什麼 */}
  <section class="page-grid mt-section gap-y-8" aria-labelledby="intro-title">
    <h2 id="intro-title" class="eyebrow col-span-4 text-smoke md:col-span-3">
      {t('home.introTitle')}
    </h2>
    <div class="col-span-4 space-y-6 md:col-span-8 md:col-start-5">
      <p
        class:list={[
          'text-headline leading-[1.3]',
          lang === 'zh-tw' ? 'font-serif-tc' : 'font-display',
        ]}
      >
        {t('home.introLead', { from })}
      </p>
      <p class="max-w-[40em] text-lead text-smoke" data-reveal-up>
        {t('home.introBody', { from, to: latest.year, count: colorCount })}
      </p>
    </div>
  </section>

  {/* 歷年色帶 */}
  <section class="mt-section" aria-labelledby="spectrum-title">
    <div class="page-grid mb-8 items-baseline">
      <h2
        id="spectrum-title"
        class="col-span-4 font-display text-headline md:col-span-8"
        data-split
      >
        {t('home.spectrumTitle', { count: years.length })}
      </h2>
      <a
        href={localePath(lang, '/archive/')}
        class="eyebrow col-span-4 justify-self-start border-b border-current pb-1 md:col-span-4 md:justify-self-end"
      >
        {t('home.enterArchive')} <span aria-hidden="true">→</span>
      </a>
    </div>
    <ol
      class="grid h-[42vh] min-h-64 grid-cols-9 px-gutter md:flex"
      aria-label={t('home.spectrumLabel')}
    >
      {years.map((y) => (
        <li class="group relative flex-1 transition-[flex-grow] duration-500 ease-out-expo hover:flex-[4] focus-within:flex-[4]">
          <a
            href={localePath(lang, `/years/${y.year}/`)}
            class="flex h-full flex-col"
            aria-label={t('year.swatchLabel', {
              year: y.year,
              names: y.colors.map((c) => c.name).join(' & '),
            })}
          >
            {y.colors.map((c) => (
              <span class="flex-1" style={`background:${c.hex}`} data-cursor-color={c.hex} />
            ))}
            <span
              class="absolute -bottom-7 left-0 text-[0.6875rem] text-smoke tabular-nums opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100 max-md:hidden"
              aria-hidden="true"
            >
              {y.year}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  {/* 近年 */}
  <section class="page-grid mt-section gap-y-10" aria-labelledby="recent-title">
    <h2 id="recent-title" class="eyebrow col-span-4 text-smoke md:col-span-12">
      {t('home.recent')}
    </h2>
    <ul class="col-span-4 grid grid-cols-2 gap-col sm:grid-cols-3 md:col-span-12 md:grid-cols-5">
      {recent.map((y) => (
        <li>
          <Swatch
            entry={y}
            href={localePath(lang, `/years/${y.year}/`)}
            transitionName={`swatch-${y.year}`}
          />
        </li>
      ))}
    </ul>
  </section>
</Base>
